{
  "name": "GEOpulse PDF panel (HTML del informe + Header Auth -> Gotenberg)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "geopulse-pdf-panel",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        180,
        300
      ],
      "name": "Webhook",
      "webhookId": "geopulse-pdf-panel",
      "credentials": {
        "httpHeaderAuth": {
          "name": "GEOpulse Panel - Header Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// HTML del informe ya maquetado por el panel. La autenticacion la hizo el Webhook\n// (Header Auth) y la ruta del panel ya comprobo sesion y propiedad del run.\nconst b = $json.body || $json;\nconst html = String(b.html || '');\nif (!html.startsWith('<!doctype html>')) throw new Error('Falta el HTML del informe');\nif (html.length > 15000000) throw new Error('HTML demasiado grande');\nreturn [{ json: { html, run_id: String(b.run_id || '') } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        300
      ],
      "name": "Datos PDF"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// HTML de la plantilla -> fichero binario 'index.html' para Gotenberg (su ruta\n// /forms/chromium/convert/html exige el fichero principal con ese nombre).\nconst html = String($json.html || '');\nreturn [{ json: { email: $json.email || '' },\n  binary: { index_html: { data: Buffer.from(html, 'utf8').toString('base64'),\n    mimeType: 'text/html', fileName: 'index.html' } } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ],
      "name": "Preparar HTML"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://85.31.237.167:3000/forms/chromium/convert/html",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "files",
              "inputDataFieldName": "index_html"
            },
            {
              "parameterType": "formData",
              "name": "printBackground",
              "value": "true"
            },
            {
              "parameterType": "formData",
              "name": "paperWidth",
              "value": "8.27"
            },
            {
              "parameterType": "formData",
              "name": "paperHeight",
              "value": "11.7"
            },
            {
              "parameterType": "formData",
              "name": "waitDelay",
              "value": "1s"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "responseFormat": "file",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1080,
        300
      ],
      "name": "Gotenberg PDF",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "respondWith": "binary",
        "responseBinaryPropertyName": "data",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/pdf"
              },
              {
                "name": "Content-Disposition",
                "value": "attachment; filename=\"informe-geopulse.pdf\""
              },
              {
                "name": "X-Robots-Tag",
                "value": "noindex, nofollow"
              }
            ]
          }
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1260,
        220
      ],
      "name": "Responder PDF"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "return [{ json: { ok: false, error: 'servicio' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1260,
        420
      ],
      "name": "Cuerpo Error"
    },
    {
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "X-Robots-Tag",
                "value": "noindex, nofollow"
              }
            ]
          },
          "responseCode": 502
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1440,
        420
      ],
      "name": "Responder Error"
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Datos PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Datos PDF": {
      "main": [
        [
          {
            "node": "Preparar HTML",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Preparar HTML": {
      "main": [
        [
          {
            "node": "Gotenberg PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gotenberg PDF": {
      "main": [
        [
          {
            "node": "Responder PDF",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Cuerpo Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cuerpo Error": {
      "main": [
        [
          {
            "node": "Responder Error",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataSuccessExecution": "none"
  }
}