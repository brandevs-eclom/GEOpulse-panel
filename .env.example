# =====================================================================
# GEOpulse Panel — variables de entorno
# Copia este fichero a .env.local y rellénalo. NUNCA subas .env.local al repo.
# =====================================================================

# --- n8n --------------------------------------------------------------
# n8n es a la vez el motor de análisis Y la puerta de entrada a la base de datos:
# el Postgres vive dentro de ese servidor y no tiene salida al exterior, así que
# el panel NO abre conexión directa. No existe DATABASE_URL a propósito.
#
# Las API keys de OpenAI/Anthropic/Gemini/Perplexity NO viven aquí: están en las
# credenciales de n8n. El panel nunca las toca.
N8N_BASE_URL=https://api.brandevs.com

# --- Capa de datos (workflow `panel-db`) ------------------------------
# Ruta del webhook que ejecuta las consultas contra el Postgres local.
N8N_PANEL_DB_PATH=panel-db

# Secreto compartido que el panel envía en la cabecera `x-panel-secret`.
# CRÍTICO: este webhook es la única puerta a la base de datos y está expuesto a
# internet. Sin un secreto fuerte, cualquiera que descubra la URL puede leer y
# escribir el histórico de auditorías. Genera uno con:  openssl rand -hex 32
# En n8n se configura como credencial "Header Auth" del nodo Webhook.
N8N_PANEL_DB_SECRET=

# --- Análisis (fase 1) ------------------------------------------------
# Rutas de los webhooks de análisis que usa el panel. Son variantes distintas de
# las públicas: responden al momento con un ack y escriben el resultado en
# Postgres al terminar, en vez de sostener la conexión varios minutos.
# Se generan con workflows/build_lite2_panel.py y build_audit_panel.py.
N8N_PATH_LITE=geopulse-lite2-panel
# Ojo: el COMPLETO cuesta ~64 llamadas LLM de pago por ejecución.
N8N_PATH_COMPLETO=geopulse-audit-panel

# Token opcional si los webhooks de análisis van protegidos.
N8N_WEBHOOK_TOKEN=

# --- Control de ejecuciones -------------------------------------------
# Tope de análisis simultáneos. Es la defensa de gasto: un informe completo son
# ~64 llamadas LLM de pago. Súbelo con cuidado.
MAX_CONCURRENT_RUNS=2

# Minutos sin resultado tras los cuales una ejecución se da por perdida.
# La media real es de 5-7 min, así que deja margen.
STALE_MINUTES=15

# --- Auth -------------------------------------------------------------
# Secreto con el que se FIRMA la cookie de sesión. Genera uno con:
#   openssl rand -hex 32
# (hex, no base64: evita los '=' del final, que se pegan mal en algunos campos).
#
# OBLIGATORIO: sin esto nadie puede entrar. El panel compila y despliega igual,
# así que el fallo no aparece hasta el primer intento de login. Dalo de alta
# también en Vercel (Production y Preview) ANTES de desplegar.
#
# Si lo cambias, TODAS las sesiones abiertas dejan de valer y todo el mundo
# vuelve a entrar con su contraseña. Es justo el botón de emergencia para
# expulsar a alguien en el acto (ver README, sección Usuarios).
#
# Si el valor difiere entre Preview y Production, las sesiones no se comparten
# entre los dos entornos.
AUTH_SECRET=
